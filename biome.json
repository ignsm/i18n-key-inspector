{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "test/**", "scripts/**", "*.ts", "*.json"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "semicolons": "asNeeded", "quoteStyle": "single", "trailingCommas": "es5" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useReadonlyClassProperties": "error"
      },
      "complexity": { "noExcessiveCognitiveComplexity": "warn" }
    }
  }
}
